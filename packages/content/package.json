{
  "name": "@mentor/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run",
    "validate": "node --conditions=development --import tsx src/cli.ts",
    "sources:sync": "node scripts/sync-hackfrontend.mjs"
  },
  "dependencies": {
    "@mentor/shared": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
