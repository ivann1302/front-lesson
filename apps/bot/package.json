{
  "name": "@mentor/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=development --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test:runtime": "node --input-type=module -e \"await import('./dist/api.js'); await import('./dist/config.js'); console.log('Bot runtime imports: ok')\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run"
  },
  "dependencies": {
    "@mentor/shared": "workspace:*",
    "fastify": "^5.4.0",
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
